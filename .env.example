# Only needed for:  docker compose --profile apps up -d --build
# Copy this file to ".env" and fill in your Neon values (use the JDBC form, direct connection, pooling OFF).
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR-HOST.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=YOUR_USER
SPRING_DATASOURCE_PASSWORD=YOUR_PASSWORD
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
