<?xml version="1.0" encoding="UTF-8"?>
<!--
  PARENT POM: this repo contains two independently runnable Spring Boot services:
    - cab-app               : the main backend + the web frontend (port 8080)
    - notification-service  : a separate service that consumes Kafka events (port 8081)
  Both inherit the Spring Boot version and Java version from here so they stay in sync.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>cab-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>cab-booking-system</name>

    <properties>
        <java.version>21</java.version>
        <!-- Must equal the version in the <parent> block above -->
        <spring-boot.release>3.5.16</spring-boot.release>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Safety net: never let a Spring Boot 4 jar into this Boot 3.5 project -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-autoconfigure</artifactId>
                <version>${spring-boot.release}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <modules>
        <module>cab-app</module>
        <module>notification-service</module>
    </modules>
</project>
